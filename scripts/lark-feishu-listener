#!/usr/bin/env python3
"""Listen for Feishu p2p messages to this machine's CLI bot and execute commands."""

from __future__ import annotations

import json
import os
import platform
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

LARK_CLI = os.environ.get("LARK_CLI", "lark-cli")
HOST_LABEL = os.environ.get("HOST_LABEL", platform.node())
ALLOWED_SENDER = os.environ.get("ALLOWED_SENDER", "")
RUN_TIMEOUT_SEC = int(os.environ.get("RUN_TIMEOUT_SEC", "120"))
LOG_DIR = Path(os.environ.get("LARK_BOT_LOG_DIR", Path.home() / ".local/log/lark-bot"))
LOG_DIR.mkdir(parents=True, exist_ok=True)
LOG_FILE = LOG_DIR / "listener.log"

MAX_REPLY_CHARS = 3800
_seen_event_ids: dict[str, float] = {}
_seen_lock = threading.Lock()
_DEDUP_TTL_SEC = 3600


def log(msg: str) -> None:
    line = f"{datetime.now(timezone.utc).isoformat()} {msg}\n"
    sys.stderr.write(line)
    sys.stderr.flush()
    with LOG_FILE.open("a", encoding="utf-8") as fh:
        fh.write(line)


def prune_seen() -> None:
    now = time.time()
    with _seen_lock:
        expired = [k for k, ts in _seen_event_ids.items() if now - ts > _DEDUP_TTL_SEC]
        for k in expired:
            del _seen_event_ids[k]


def is_duplicate(event_id: str) -> bool:
    if not event_id:
        return False
    prune_seen()
    with _seen_lock:
        if event_id in _seen_event_ids:
            return True
        _seen_event_ids[event_id] = time.time()
        return False


def lark_reply(message_id: str, text: str) -> None:
    if len(text) > MAX_REPLY_CHARS:
        text = text[: MAX_REPLY_CHARS - 20] + "\n...(truncated)"
    result = subprocess.run(
        [
            LARK_CLI,
            "im",
            "+messages-reply",
            "--as",
            "bot",
            "--message-id",
            message_id,
            "--text",
            text,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        log(f"reply failed message_id={message_id} stderr={result.stderr.strip()}")


def cmd_status() -> str:
    uptime = subprocess.run(
        ["uptime", "-p"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    load = os.getloadavg()
    disk = subprocess.run(
        ["df", "-h", "/"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip().splitlines()
    disk_line = disk[-1] if disk else "n/a"
    return (
        f"[{HOST_LABEL}] status\n"
        f"host: {platform.node()}\n"
        f"uptime: {uptime or 'n/a'}\n"
        f"load: {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}\n"
        f"disk(/): {disk_line}\n"
        f"time(UTC): {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')}"
    )


def cmd_help() -> str:
    return (
        f"[{HOST_LABEL}] commands\n"
        "ping — health check\n"
        "help — this message\n"
        "status — host uptime/load/disk\n"
        "run <shell> — run command on this server (timeout configurable)\n"
        "\n"
        "Tip: use a unique HOST_LABEL per machine when running multiple bots."
    )


def cmd_run(shell_cmd: str) -> str:
    if not shell_cmd:
        return f"[{HOST_LABEL}] usage: run <command>"
    log(f"run command: {shell_cmd!r}")
    try:
        completed = subprocess.run(
            shell_cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=RUN_TIMEOUT_SEC,
            cwd=str(Path.home()),
        )
    except subprocess.TimeoutExpired:
        return f"[{HOST_LABEL}] run timed out after {RUN_TIMEOUT_SEC}s"
    parts = [f"[{HOST_LABEL}] exit={completed.returncode}"]
    if completed.stdout.strip():
        parts.append("stdout:\n" + completed.stdout.strip())
    if completed.stderr.strip():
        parts.append("stderr:\n" + completed.stderr.strip())
    if len(parts) == 1:
        parts.append("(no output)")
    return "\n".join(parts)


def handle_message(content: str, message_id: str) -> None:
    text = content.strip()
    if not text:
        return

    lower = text.lower()
    if lower == "ping":
        reply = f"pong from {HOST_LABEL}"
    elif lower == "help":
        reply = cmd_help()
    elif lower == "status":
        reply = cmd_status()
    elif lower.startswith("run "):
        reply = cmd_run(text[4:].strip())
    else:
        reply = (
            f"[{HOST_LABEL}] 已收到: {text}\n"
            "回复 help 查看可用命令。"
        )

    lark_reply(message_id, reply)


def wait_for_ready(stderr) -> None:
    for line in stderr:
        line = line.rstrip("\n")
        log(line)
        if "[event] ready event_key=im.message.receive_v1" in line:
            return
    raise RuntimeError("event consume exited before ready marker")


def main() -> int:
    if not ALLOWED_SENDER:
        log("ALLOWED_SENDER is required; set it in listener.env")
        return 1

    jq_filter = (
        f'select(.chat_type=="p2p" and .sender_id=="{ALLOWED_SENDER}" '
        f'and .message_type=="text")'
    )

    log(
        f"starting listener host_label={HOST_LABEL} allowed_sender={ALLOWED_SENDER}"
    )

    tail = subprocess.Popen(
        ["tail", "-f", "/dev/null"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    consume = subprocess.Popen(
        [
            LARK_CLI,
            "event",
            "consume",
            "im.message.receive_v1",
            "--as",
            "bot",
            "--jq",
            jq_filter,
        ],
        stdin=tail.stdout,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    if tail.stdout:
        tail.stdout.close()

    ready_thread = threading.Thread(
        target=wait_for_ready, args=(consume.stderr,), daemon=True
    )
    ready_thread.start()
    ready_thread.join(timeout=60)
    if ready_thread.is_alive():
        log("timeout waiting for event ready marker")
        consume.terminate()
        return 1

    log("listener ready; waiting for messages")

    for line in consume.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            log(f"invalid json: {line[:200]}")
            continue

        event_id = event.get("event_id", "")
        if is_duplicate(event_id):
            log(f"skip duplicate event_id={event_id}")
            continue

        message_id = event.get("message_id") or event.get("id")
        content = event.get("content", "")
        if not message_id:
            log(f"skip event without message_id: {event}")
            continue

        log(f"message message_id={message_id} content={content!r}")
        try:
            handle_message(content, message_id)
        except Exception as exc:  # noqa: BLE001
            log(f"handler error: {exc}")
            lark_reply(message_id, f"[{HOST_LABEL}] internal error: {exc}")

    consume.wait()
    log(f"event consume exited code={consume.returncode}")
    return consume.returncode or 0


if __name__ == "__main__":
    raise SystemExit(main())
