# Copy to ~/.config/lark-bot/listener.env and edit values.

# Short label shown in bot replies (unique per machine if you run multiple bots).
HOST_LABEL=my-server

# Full path to lark-cli if systemd cannot find it (common with nvm).
# Leave empty to use `lark-cli` from PATH.
LARK_CLI=

# Your Feishu open_id (ou_xxx). Only this user can trigger commands.
# Get it after OAuth login: lark-cli auth status
ALLOWED_SENDER=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Timeout for `run <command>` in seconds.
RUN_TIMEOUT_SEC=120

# Cursor Agent for free-form questions (project status, docs, etc.).
AGENT_ENABLED=1
AGENT_CMD=/home/you/.local/bin/agent
AGENT_CWD=/home/you/your-project
AGENT_MODE=ask
AGENT_TIMEOUT_SEC=300
